# MongoDB connection string (required)
# Get this from MongoDB Atlas -> Connect -> Drivers
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT signing secret (required)
# Use a long random string, e.g.: openssl rand -base64 64
JWT_SECRET=your_jwt_secret_here

# Server port (optional — Railway sets this automatically)
PORT=3000

# ML service URL for visual search image embeddings (optional)
# If not set, defaults to http://localhost:8000
ML_SERVICE_URL=http://localhost:8000

# Validate product URLs (HEAD request) before returning search results (optional)
# Set to "true" to enable; defaults to disabled
VALIDATE_PRODUCTS=false
